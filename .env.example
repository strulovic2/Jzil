# Copy to .env and fill in. Leave a section blank to keep using demo data for that source.
PORT=3000

# Optional: protect the dashboard with a shared password (HTTP basic auth, any username)
DASHBOARD_PASSWORD=

# --- AppFolio Reports API (Property Manager Plus/Max: Settings -> API / Reports API credentials)
APPFOLIO_DATABASE=          # the "yourco" in yourco.appfolio.com
APPFOLIO_CLIENT_ID=
APPFOLIO_CLIENT_SECRET=
# Only bring Zillow guest cards in from AppFolio when the lead source matches this (case-insensitive)
APPFOLIO_ZILLOW_SOURCE_MATCH=zillow

# --- Inbound webhooks (Zillow lead delivery, screening provider, Zapier, etc.)
# Requests must send header  X-Webhook-Secret: <this value>
WEBHOOK_SECRET=

# --- Renewal pricing
RENEWAL_MAX_INCREASE_PCT=5    # cap on suggested renewal raise
RENEWAL_WINDOW_DAYS=90        # how far ahead to look for expiring leases
